# ============================================================
# ZAVERO Backend — Environment Configuration Template
# ============================================================

NODE_ENV=production
PORT=3000

# PostgreSQL Neon Database Connection String
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Authentication JWT Secret (min 32 characters)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Public Application URLs
APP_URL=https://zavero-backend-production-7dc9.up.railway.app
ALLOWED_ORIGINS=https://zavero.uz,https://www.zavero.uz,https://zavero-backend-production-7dc9.up.railway.app

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
CHANNEL_1=@zavero_uz
CHANNEL_2=@mirzobekdev
WEBHOOK_SECRET=your_telegram_webhook_secret_token
ADMIN_PASSWORD=your_admin_panel_password
ADMIN_TELEGRAM_IDS=123456789
ADMIN_USERNAMES=admin_username
