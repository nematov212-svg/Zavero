# ZAVERO POS - Server Configuration (Vercel Serverless + Supabase)
PORT=3000
NODE_ENV=production

# JWT Authentication Secret (Generate a strong 64-char key for production)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=30d

# Supabase PostgreSQL Connection String (Transaction Pooler or Session Mode)
# Masalan: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.example:yourpassword@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require

# CORS (Production frontend domenlari yoki barcha mijozlar uchun *)
CORS_ORIGIN=*
