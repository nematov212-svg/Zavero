# ===================================================================
# ZAVERO POS - PRODUCTION & RAILWAY ENVIRONMENT VARIABLES
# ===================================================================

# 1. SERVER SOZLAMALARI
# Railway o'zi dinamik tarzda PORT beradi (masalan, 3000 yoki boshqa raqam)
PORT=3000
NODE_ENV=production

# 2. XAVFSIZLIK VA JWT AUTH
# Ixtiyoriy uzun va kuchli sirli kalit (masalan, openssl rand -hex 32)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=30d

# 3. POSTGRESQL MA'LUMOTLAR BAZASI (Neon Postgres)
# Mavjud Neon PostgreSQL ulanish manzilingiz:
# Format: postgresql://[user]:[password]@[host]/[dbname]?sslmode=require
DATABASE_URL=postgresql://user:password@ep-cool-lake-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# 4. CORS VA DOMEN SOZLAMALARI
# Barcha mijozlar (Flutter ilova, Web POS, Telegram bot) ulanishi uchun '*'
CORS_ORIGIN=*

# Web ilovaning to'liq URL manzili (Railway domeni yoki custom domen)
# Masalan: https://zavero-production.up.railway.app
WEBAPP_URL=https://your-service.up.railway.app

# 5. TELEGRAM BOT VA OBUNA TIZIMI
# Telegram @BotFather dan olingan bot tokeni
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Render va Railway bir vaqtda ishlab turganda bot nusxalari to'qnashuvining (409 Conflict) oldini olish:
# Railway'ni ilk bor tekshirishda 'true' qilib qo'yishingiz mumkin.
# Render'ni to'xtatgach, Railway'da 'false' qilib to'liq yoqasiz.
DISABLE_TELEGRAM_BOT=false

# Telegram Webhook rejimi (false = barqaror Auto-restarting Long-Polling, true = Express Webhook)
USE_BOT_WEBHOOK=false

# Administrator Telegram ID raqamlari (vergul bilan ajratilgan)
ADMIN_TELEGRAM_IDS=123456789,987654321

# Majburiy a'zo bo'linadigan rasmiy kanallar
REQUIRED_CHANNEL_1=@mirzobekdev
REQUIRED_CHANNEL_2=@zavero_uz

# Oylik obuna narxi (so'mda) va muddati (kunlarda)
SUBSCRIPTION_PRICE=250000
SUBSCRIPTION_DAYS=30

# Test to'lovlarini sinash imkoniyati
ALLOW_TEST_PAYMENTS=true

# 6. TO'LOV TIZIMLARI (CLICK & PAYME) - Ixtiyoriy
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
