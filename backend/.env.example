# ZAVERO POS - Server Configuration
PORT=3000
NODE_ENV=production

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=30d

# PostgreSQL Connection String (Neon or Supabase)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# CORS (Production frontend domenlari yoki barcha mijozlar uchun *)
CORS_ORIGIN=*

# Web Application URL (Telegram WebApp & Mini App)
WEBAPP_URL=https://zavero-jrna.onrender.com
RENDER_EXTERNAL_URL=https://zavero-jrna.onrender.com

# -------------------------------------------------------------
# TELEGRAM BOT & PREMIUM SUBSCRIPTION SYSTEM
# -------------------------------------------------------------
# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=8838017721:AAHMXwe9rX_6ERecTM9fHKX0ctsG6b-HOK0

# Admin Telegram IDs (Vergul bilan ajratilgan raqamlar)
ADMIN_TELEGRAM_IDS=123456789,987654321

# Majburiy a'zo bo'linadigan kanallar (Default: @zavero_official, @zavero_pos)
REQUIRED_CHANNEL_1=@mirzobekdev
REQUIRED_CHANNEL_2=@zavero_uz

# Oylik obuna narxi (so'mda) va muddati (kunlarda)
SUBSCRIPTION_PRICE=250000
SUBSCRIPTION_DAYS=30

# Webhook rejimidan foydalanish (true bo'lsa Express /api/bot/webhook orqali, false bo'lsa long-polling)
USE_BOT_WEBHOOK=false

# Test rejimida to'lovlarni oson sinash (true yoki false)
ALLOW_TEST_PAYMENTS=true

# -------------------------------------------------------------
# CLICK TO'LOV TIZIMI SOZLAMALARI
# -------------------------------------------------------------
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# -------------------------------------------------------------
# PAYME TO'LOV TIZIMI SOZLAMALARI
# -------------------------------------------------------------
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
